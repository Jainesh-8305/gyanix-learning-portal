# backend/.env.example
# Copy this file to .env and fill in real values.
# NEVER commit .env to git — it is already in .gitignore.

PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# ── Database ──────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/ai-lms

# ── Auth ──────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_generate_a_long_random_string
JWT_EXPIRE=7d

# ── OpenAI ────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── Stripe ────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
# Get webhook secret from: stripe listen --forward-to localhost:5000/api/payments/webhook
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Cloudinary ────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ── Email (Gmail App Password recommended) ────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=youraddress@gmail.com
# Generate at: https://myaccount.google.com/apppasswords
EMAIL_PASS=your-gmail-app-password
EMAIL_FROM=AI-LMS <youraddress@gmail.com>